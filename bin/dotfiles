#!/bin/sh
#
# dotfiles
#
# `dotfiles` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
dotfilesDirectory="$(CDPATH= cd -- "$parentDirectory/.." && pwd -P)"

displayUsageAndExit() {
	echo "dotfiles -- dotfiles management"
	echo ""
	echo "Usage: dotfiles [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH="$dotfilesDirectory"

# Set macOS defaults
"$ZSH/macos/set-defaults.sh"

# Install homebrew
. "$ZSH/brew/install.sh"

# Update homebrew
echo "› brew update"
brew update

# Install and reconcile Homebrew packages
echo "› brew bundle"
brew bundle --file "$ZSH/brew/Brewfile"

# Install configured development runtimes
echo "› mise install"
. "$ZSH/ruby/env.zsh"
MISE_GLOBAL_CONFIG_FILE="$ZSH/mise/config.toml" mise install

# Report available development runtime and tool updates without changing pins
echo "› mise outdated"
MISE_GLOBAL_CONFIG_FILE="$ZSH/mise/config.toml" mise outdated
echo "› run 'mise upgrade --bump --interactive' to review and update pinned versions"

# Install software
echo "› $ZSH/script/install"
"$ZSH/script/install"
