scriptencoding utf-8
set encoding=utf-8

" Enable 24-bit RGB color
set termguicolors
colorscheme sorbet

" Leader
let mapleader=";"

" Syntax and filetypes
syntax on
filetype indent plugin on

" Files and buffers

" Auto-reload files when changed outside of Vim
set autoread

" Makes backspace behave like you'd expect
set backspace=2

" Allow buffers to be backgrounded without being saved
set hidden

" Display

" Always show the status bar
set laststatus=2

" Show invisible characters
set list

" Set the characters for invisibles
set listchars=tab:›\ ,eol:¬,trail:⋅

" Show relative line numbers
set relativenumber

" Show line numbers
set number

" Customize the ruler format to show line and column
set rulerformat=%l\:%c

" Show the line number and column in the status bar
set ruler

" Keep the cursor centered in the screen
set scrolloff=999

" Highlight matching braces
set showmatch

" Show the current mode
set showmode

" Show incomplete commands
set showcmd

" Splits show up below by default
set splitbelow

" Splits go to the right by default
set splitright

" Show command completion in the status line
set wildmenu

" Redraw only when necessary
set lazyredraw

" Backup and undo

" Set backup directories
set backupdir=~/.vim-tmp,~/.tmp,~/tmp,/var/tmp,/tmp

" Skip backups for these directories
set backupskip=/tmp/*,/private/tmp/*

" Set swap file directories
set directory=~/.vim-tmp,~/.tmp,~/tmp,/var/tmp,/tmp

" Enable backup files
set backup

" Enable undo files
set undofile

" Write a backup file before overwriting
set writebackup

" Searching

" Show search matches as you type
set incsearch

" Highlight search matches
set hlsearch

" Ignore case when searching
set ignorecase

" Use case-sensitive search when uppercase characters are present
set smartcase

" Clear search highlighting with leader+h
nnoremap <leader>h :nohlsearch<CR>

" Key mappings

" Shortcuts to yanking to and pasting from the system clipboard
map <leader>y "+y
map <leader>p "+p

" Make j/k move by visual lines instead of physical lines
map j gj
map k gk

" Don't require ! for :q and :wq
" This makes it easier to quit when files are readonly
cnoreabbrev q q!
cnoreabbrev wq wq!
cnoreabbrev qa qa!
cnoreabbrev wqa wqa!

" Autocommands

" Don't fold anything
autocmd BufWinEnter * set foldlevel=999999

" Clear whitespace at the end of lines automatically
autocmd BufWritePre * :%s/\s\+$//e
